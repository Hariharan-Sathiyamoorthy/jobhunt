container_commands:
  01_migrate:
    command: "source /var/app/venv/*/bin/activate && python3 manage.py migrate"
    leader_only: true
  02_collectstatic:
    command: "source /var/app/venv/*/bin/activate && python3 manage.py collectstatic --noinput"
  03_chmod:
    command: "chmod 664 /var/app/current/db.sqlite3"
  04_chown:
    command: "chown webapp:webapp /var/app/current/db.sqlite3"
  05_chmod_dir:
    command: "chmod 775 /var/app/current"
  06_chown_dir:
    command: "chown webapp:webapp /var/app/current"
option_settings:
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: jobhunt.settings